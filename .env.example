# ==========================================
# GROKSON — НАСТРОЙКИ ДЛЯ ПОЛЬЗОВАТЕЛЯ
# ==========================================
# Все сложные параметры (SESSION_SECRET, DATABASE_PATH, 
# ADMIN_PASSWORD_HASH, ALLOWED_ORIGIN, AI_MODEL) генерируются 
# АВТОМАТИЧЕСКИ и НЕ требуют ручного ввода!

# 1. Секретный ключ ИИ (Gemini, OpenAI или GigaChat)
# Введите в AI Studio Settings -> Secrets (переменная AI_API_KEY или GEMINI_API_KEY)
AI_API_KEY=
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# 2. Необязательно: Ваш пароль администратора (по умолчанию: admin123)
# Хеш пароля создается автоматически!
ADMIN_LOGIN=admin
ADMIN_PASSWORD=admin123


